# Application
APP_NAME=license-plate-detector
APP_VERSION=1.0.0
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false
LOG_LEVEL=INFO

# Model
MODEL_WEIGHTS=models/license_plate_detector.pt
MODEL_CFG=yolov9/models/detect/yolov9-e.yaml
DATA_YAML=dataset/data.yaml
IMG_SIZE=640
CONF_THRES=0.25
IOU_THRES=0.45
MAX_DET=1000
DEVICE=cpu
HALF=false

# Security
API_KEY=
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW=60
MAX_UPLOAD_MB=10

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
